{
  "buildCommand": "VERCEL=1 npm run build",
  "outputDirectory": ".vercel/output",
  "framework": null,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/openai", "dest": "/__server" },
    { "src": "/api/openai/", "dest": "/__server" },
    { "src": "/api/send-cv", "dest": "/__server" },
    { "src": "/api/send-cv/", "dest": "/__server" },
    { "src": "/api/reviews", "dest": "/__server" },
    { "src": "/api/reviews/", "dest": "/__server" },
    { "src": "/api/purchase", "dest": "/__server" },
    { "src": "/api/purchase/", "dest": "/__server" },
    { "src": "/api/ocr-resume", "dest": "/__server" },
    { "src": "/api/ocr-resume/", "dest": "/__server" }
  ]
}
