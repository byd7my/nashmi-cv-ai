# ── OpenAI (server-only — used by /api/openai on Vercel) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Supabase (server-only) ────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public anon key for future client-side Supabase features
# SUPABASE_ANON_KEY=

# Max AI Improve presses per button per CV session (default: 3)
AI_RATE_LIMIT_MAX=3

# Max translation API chunks per CV session — enough for 1–2 full bilingual runs while editing (default: 40)
AI_TRANSLATE_LIMIT_MAX=40

# Max Copilot messages per CV session while editing (default: 35)
AI_COPILOT_LIMIT_MAX=35

# Max AI-powered CV imports per session; local parser still works after the limit (default: 3)
AI_PARSE_LIMIT_MAX=3

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Must use your verified domain (nashmi.club) — not onboarding@resend.dev in production
EMAIL_FROM=Nashmi <no-reply@nashmi.club>
EMAIL_REPLY_TO=support@nashmi.club
