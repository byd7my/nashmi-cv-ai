# ── OpenAI (server-only — used by /api/openai on Vercel) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Supabase (server-only) ────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public anon key for future client-side Supabase features
# SUPABASE_ANON_KEY=

# Plan-based AI limits (per CV session, sent via x-nashmi-plan-tier header)
# Premium defaults: improve 3/button, assistant 20, translate 0, parse 2
AI_PREMIUM_IMPROVE_MAX=3
AI_PREMIUM_ASSISTANT_MAX=20
AI_PREMIUM_TRANSLATE_MAX=0
AI_PREMIUM_PARSE_MAX=2

# Elite defaults: improve 5/button, assistant 40, translate 45, parse 3
AI_ELITE_IMPROVE_MAX=5
AI_ELITE_ASSISTANT_MAX=40
AI_ELITE_TRANSLATE_MAX=45
AI_ELITE_PARSE_MAX=3

# Run supabase/migrations/20250611190000_create_purchases.sql for server-side plan verification

# ── Internal API (server-only) ────────────────────────────────────────
# Shared secret checked against the x-internal-key header on
# POST /api/generate-cv (called by the Telegram bot, not the website).
# Generate a long random value and never commit the real value.
INTERNAL_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Must use your verified domain (nashmi.club) — not onboarding@resend.dev in production
EMAIL_FROM=Nashmi <no-reply@nashmi.club>
EMAIL_REPLY_TO=nashmicv@outlook.com
