# ── OpenAI (server-only — used by /api/openai on Vercel) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Supabase (server-only) ────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public anon key for future client-side Supabase features
# SUPABASE_ANON_KEY=

# Max AI Improve requests per session/IP within a 24-hour window (default: 3)
AI_RATE_LIMIT_MAX=3

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Must use your verified domain (nashmi.club) — not onboarding@resend.dev in production
EMAIL_FROM=Nashmi <no-reply@nashmi.club>
EMAIL_REPLY_TO=support@nashmi.club
